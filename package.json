{
  "name": "gd-desktop",
  "version": "0.1.0",
  "description": "GD Esports desktop app — League stats dashboard",
  "author": "GD Esports",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dist": "node server/prepare-client-env.js && vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win",
    "dist:portable": "node server/prepare-client-env.js && vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gdesports.desktop",
    "productName": "GD Esports",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      },
      {
        "from": "client.env",
        "to": "gd.env"
      }
    ],
    "extraFiles": [
      {
        "from": "client.env",
        "to": "gd.env"
      }
    ],
    "forceCodeSigning": false,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GD Esports",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
