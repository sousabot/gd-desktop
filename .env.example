# Copy this file to .env for local development (npm run dev / npm run server).
# Get a key at https://developer.riotgames.com
RIOT_API_KEY=

# Discord channel webhook for the Report feedback / bugs form.
DISCORD_WEBHOOK_URL=

# Optional: desktop talks to your hosted proxy instead of Riot directly.
# GD_API_URL=https://your-service.onrender.com
# GD_APP_TOKEN=
