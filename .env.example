# Copy this file to .env for local development (npm run dev / npm run server).
# Get a key at https://developer.riotgames.com
RIOT_API_KEY=

# Discord channel webhook for the Report feedback / bugs form.
DISCORD_WEBHOOK_URL=

# Packaged builds use client.env (GD_API_URL + GD_APP_TOKEN) instead of this file.
GD_API_URL=https://gd-desktop.onrender.com
GD_APP_TOKEN=

# Overwolf overlay keys (overlays are disabled in this build).
# Create an account at https://dev.overwolf.com → Profile → API Keys
OW_CLI_EMAIL=
OW_CLI_API_KEY=
# Or, once Developer status is Approved: OW_DEV_KEY=
