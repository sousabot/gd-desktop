# Copy this file to .env (dev) or next to GD Esports.exe / %APPDATA%\gd-desktop\.env (installed).
# Get a key at https://developer.riotgames.com — personal-use keys expire every 24h.
RIOT_API_KEY=

# Discord channel webhook for the Report feedback / bugs form.
# Channel settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=
